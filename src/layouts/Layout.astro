---
import Navbar from '@/components/layout/Navbar.astro';
import SideMenu from '@/components/layout/SideMenu.astro';
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logo-coffe.png" />
		<title>Coffté | Bebidas Naturales</title>
		<meta name="description" content="Coffté transforma la pulpa de café en bebidas naturales únicas, endulzadas con panela y elaboradas en Risaralda. Innovación, sabor y sostenibilidad desde Quinchía." />
		<meta name="keywords" content="Coffté, bebidas naturales, pulpa de café, café colombiano, productos artesanales, sostenibilidad, panela, Quinchía, Risaralda" />
		<meta name="author" content="Hoover Adolfo Trejos" />
		<meta property="og:title" content="Coffté | Bebidas Naturales con Pulpa de Café" />
		<meta property="og:description" content="Innovadoras bebidas a base de café, panela y jengibre, creadas en Quinchía con amor por el campo y el medio ambiente." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://refrescoscoffte.com/" />
	</head>
	<body>
		<Navbar />
		<SideMenu />
		<slot />
	</body>
</html>
