---
import '@fontsource/poppins';
import '@fontsource/poppins/700.css';
---

<section class="w-full h-auto bg-[#fefede] 2xl:px-72 sm:px-10 px-6 py-16">
    <span class="flex items-center justify-center font-[Poppins] gap-3">
        <p class="text-green-950 text-4xl font-bold">Galería</p>
        <hr class="w-[100%] border-green-900">
    </span>
    <div class="grid grid-cols-5 gap-8 mt-10">
        <img  class="w-full h-[320px] col-span-5 lg:col-span-1 rounded-3xl object-cover hover:scale-105 transition-all duration-300" src="img/gallery/jegibre-img.jpg" alt="">
        <img class="w-full lg:col-span-2 col-span-5 h-[320px]  rounded-3xl object-cover" src="img/gallery/cultivo-cana.jpg" alt="">
        <img  class="w-full h-[320px] col-span-5 lg:col-span-1 rounded-3xl object-cover hover:scale-105 transition-all duration-300" src="img/gallery/coffte-michelado.jpg" alt="">
        <img  class="w-full h-[320px] col-span-5 lg:col-span-1 rounded-3xl object-cover hover:scale-105 transition-all duration-300" src="img/gallery/agua-img.jpg" alt="">

        <div class="w-full sm:h-[400px] lg:col-span-5 xl:text-center col-span-5 bg-gradient-to-r from-[#ff8a1c] via-[#f98c25] to-[#f85f00] rounded-3xl sm:mt-12 flex items-start xl:items-center justify-center p-11 flex-col">
            <h1 class="sm:text-6xl text-5xl font-extrabold font-[Poppins] text-[#121213]">¿Ya disfrutaste hoy de un vaso de <span class="text-white">Coffté</span>?</h1>
            <p class="text-[#121213] sm:text-xl text-sm font-[Poppins]">¿Qué esperas? Descubre nuestros tres sabores y anímate a probarlos. ¡Te encantarán!</p>
        </div>
    </div>
</section>