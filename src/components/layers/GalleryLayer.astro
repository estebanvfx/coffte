---
import '@fontsource/poppins';
import '@fontsource/poppins/700.css';
---

<section class="w-full h-auto bg-[#fefede] px-4 sm:px-6 md:px-12 lg:px-24 xl:px-72 py-8 md:py-8">
    <span class="flex items-center justify-center font-[Poppins] gap-3">
        <p class="text-green-950 text-2xl md:text-3xl lg:text-4xl font-bold">Galería</p>
        <hr class="w-[100%] border-green-900">
    </span>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-6 lg:gap-8 mt-6 lg:mt-10">
        <img class="w-full h-[250px] md:h-[320px] rounded-3xl object-cover hover:scale-105 transition-all duration-300" src="img/gallery/jegibre-img.jpg" alt="">
        <img class="w-full sm:col-span-2 h-[250px] md:h-[320px] rounded-3xl object-cover" src="img/gallery/cultivo-cana.jpg" alt="">
        <img class="w-full h-[250px] md:h-[320px] rounded-3xl object-cover hover:scale-105 transition-all duration-300" src="img/gallery/coffte-michelado.jpg" alt="">
        <img class="w-full h-[250px] md:h-[320px] rounded-3xl object-cover hover:scale-105 transition-all duration-300" src="img/gallery/agua-img.jpg" alt="">

        <div class="w-full h-auto  col-span-1 sm:col-span-2 lg:col-span-3 bg-gradient-to-r from-[#ff8a1c] via-[#f98c25] to-[#f85f00] rounded-3xl mt-6 lg:mt-12 flex items-start justify-center p-6 md:p-8 lg:p-11 flex-col gap-4">
            <h1 class="text-3xl sm:text-2xl lg:text-4xl font-extrabold font-[Poppins] text-[#121213] leading-tight">¿Ya disfrutaste hoy de un vaso de <span class="text-white">Coffté</span>?</h1>
            <p class="text-[#121213] text-lg lg:text-xl font-[Poppins]">¿Qué esperas? Descubre nuestros tres sabores y anímate a probarlos. ¡Te encantarán!</p>
        </div>
    </div>
</section>