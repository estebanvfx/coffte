---
import '@fontsource/satisfy';
import '@fontsource/poppins';
import CheckList from '@/components/CheckList.astro';
import { Icon } from 'astro-icon/components';
import CardFacts from '@/components/CardFacts.astro';
---

<section id="sobre-nosotros" class="w-full h-auto bg-[#fdf7ee] md:px-44 py-10 texto-general">
    <div class="w-full h-full grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Texto y Lista -->
        <div class="w-full h-full texto-container">
            <h1 class="text-[#3d1218] cursive-font font-semibold text-3xl mb-3">¡Acerca de Coffté!</h1>
            <h2 class="text-black text-4xl md:text-5xl font-bold">Sabor Natural en Cada Sorbo</h2>
            <p class="text-black text-base md:text-lg font-medium mt-5">
                Disfruta el placer de una bebida deliciosa y saludable, creada con ingredientes frescos y naturales para tu bienestar.
            </p>
            <ul class="text-black text-sm md:text-base font-medium mt-4">
                <CheckList body="Placer y bienestar en cada sorbo." />
                <CheckList body="Frutas frescas, hierbas y miel de panela." />
                <CheckList body="Altos estándares en cada etapa." />
                <CheckList body="Uso sostenible de recursos." />
                <CheckList body="Innovadoras y deliciosas." />
            </ul>
        </div>

        <!-- Imagen -->
        <div class="w-full h-full flex justify-center items-center md:order-last">
            <img class="w-auto h-[45vh] md:h-[55vh] rounded-xl shadow-xl" src="/img/coffte-layer.jpg" alt="Coffte">
        </div>
    </div>

    <!-- Separador -->
    <span class="flex justify-center items-center my-8">
        <hr class="w-[30%] md:w-[50%] border-green-900">
        <Icon name="leaf-solid" class="text-green-900 text-4xl md:text-5xl mx-4" />
        <hr class="w-[30%] md:w-[50%] border-green-900">
    </span>

    <!-- Cartas -->
    <div class="w-full flex flex-col items-center">
        <h1 class="text-black font-bold text-3xl md:text-5xl mb-5 titulo-detalles">
            Conoce <span class="cursive-font text-[#581010]">los</span> Detalles!
        </h1>
        <div class="cards-grid-container w-full max-w-screen-xl px-4 mt-10 justify-items-center">
            <div class="cards-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10">
                <CardFacts
                    title="Con miel de panela"
                    description="Coffté es una bebida 100% natural, fabricada con miel de panela."
                    icon="/img/1997101.png"
                />
                <CardFacts
                    title="Calidad selecta"
                    description="Coffté es una bebida orgánica, con ingredientes cuidadosamente seleccionados y sin conservantes."
                    icon="/img/icons/100-Natural.png"
                />
                <CardFacts
                    title="100% Natural"
                    description="Coffté es una bebida natural y deliciosa, creada con ingredientes frescos y naturales para tu bienestar."
                    icon="/img/icons/Biodegradable.png"
                />
            </div>
        </div>
    </div>
</section>

<style>
    .cursive-font {
        font-family: 'Satisfy', cursive;
    }

    .texto-general {
        font-family: 'Poppins', sans-serif;
    }

    .texto-container {
        padding-bottom: 20px;
    }

    .cards-grid-container {
        max-width: 1200px; 
        margin: 0 auto; 
    }

    @media (max-width: 768px) {
        .cards-grid {
            grid-template-columns: 1fr; 
        }

        .w-full.h-full {
            display: flex;
            flex-direction: column;
        }

        .texto-container {
            padding: 20px;
        }

        .md\:order-last {
            order: 2;
        }

        .md\:order-first {
            order: 1;
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .cards-grid {
            grid-template-columns: 1fr 1fr;
        }

        .w-full.h-full {
            display: flex;
            flex-direction: column;
        }

        .md\:order-last {
            order: 2;
        }

        .md\:order-first {
            order: 1;
        }

        .titulo-detalles {
        font-size: 2.25rem; /* Equivalente a 4xl */
    }
    }

    @media (min-width: 1024px) {
        .cards-grid {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }
</style>
