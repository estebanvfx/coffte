---
import '@fontsource/poppins';
import '@fontsource/poppins/700.css';
import { Icon } from 'astro-icon/components';
---

<section id="contact" class="xl:px-96 sm:px-5 py-10 bg-[#ffffff] w-full h-auto">
    <div class="rounded-2xl shadow-sm bg-white w-auto p-10">
        <h2 class="font-[Poppins] text-center font-bold text-5xl text-[#292929]">Contáctenos</h2>
        <div class="mt-10">
            <div class="my-9">
                <p class="font-[poppins] text-2xl text-[#3d1218] font-semibold">Póngase en contacto</p>
                <p class="font-[poppins] text-[#292929] font-semi">Para cualquier pregunta, comentario o consulta, no dude en ponerse en contacto con nosotros.</p>
            </div>
            <div class="flex alight-center items-center">
                <div class="bg-[#3d1218] flex items-center justify-center rounded-full w-16 h-16 mr-5">
                    <Icon name={"location-dot-solid"} class="text-white text-4xl mx-4" />
                </div>
                <div>
                    <p class="text-[#292929] text-xl font-[Poppins] font-semibold">Dirección</p>
                    <p class="text-[#292929] text-xl font-[Poppins]">Quinchia, Risaralda, Transversal 3 #5A51</p>
                </div>
            </div>
            <div class="flex alight-center items-center mt-5">
                <div class="bg-[#3d1218] flex items-center justify-center rounded-full w-16 h-16 mr-5">
                    <Icon name={"phone"} class="text-white text-4xl mx-4" />
                </div>
                <div>
                    <p class="text-[#292929] text-xl font-[Poppins] font-semibold">Telefono</p>
                    <p class="text-[#292929] text-xl font-[Poppins] font-medium">Móvil: +57 314 863 45 33 <br> Móvil: +57 300 854 40 07</p>
                </div>
            </div>
        </div>
    </div>
</section>