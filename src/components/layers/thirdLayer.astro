---
import { ReactiveLayer, ReactiveText } from '../ReactComponents/reactiveLayer';
import '@fontsource/poppins/700.css';
import '@fontsource/satisfy';
import { useEffect } from 'react';
---

<section id="products" class="bg-gradient-to-t from-[#fefede] to-[#fcb501] flex flex-col justify-center items-center p-5 ">
    <h1 class="text-center text-white text-4xl md:text-6xl font-[Poppins] font-extrabold">
        Encuentra <span class="text-green-950 font-[Satisfy]">tu</span> sabor
    </h1>
    <p class="text-center text-white text-sm md:text-lg font-[Poppins]">
        Elige entre nuestras deliciosas bebidas naturales y descubre tu combinación perfecta.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
        <div class="flex flex-col items-center p-4">
            <ReactiveLayer bgImage="img/cascara.png" bottleImage="img/layers/cafe-2.png" />
            <ReactiveText text="Coffté" text_2="Coffé" />
        </div>
        <div class="flex flex-col items-center p-4">
            <ReactiveLayer bgImage="https://static.vecteezy.com/system/resources/previews/033/303/213/non_2x/ginger-with-ai-generated-free-png.png" bottleImage="img/layers/genjibre.png" />
            <ReactiveText text="Coffté" text_2="Genjibre" />
        </div>
        <div class="flex flex-col items-center p-4">
            <ReactiveLayer bgImage="img/panela-limon.png" bottleImage="img/layers/sirope.png" />
            <ReactiveText text="Coffté" text_2="Sirope" />
        </div>
    </div>
</section>

