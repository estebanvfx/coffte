---
import { ReactiveLayer, ReactiveText } from '../ReactComponents/reactiveLayer';
import '@fontsource/poppins/700.css';
import '@fontsource/satisfy';
import { useEffect } from 'react';
---

<section id="products" class="p-5 bg-gradient-to-r from-[#f1c629] via-[#faf070] to-[#ffe043] h-auto py-36 flex flex-col justify-center items-center">
    <h1 class="text-center text-6xl font-[Poppins] font-extrabold text-[#1e1e20]">Encuentra <span class="text-green-950 font-[Satisfy]">tu</span> sabor</h1>
    <p class="text-center text-[#1e1e20] text-lg font-[Poppins]">Elige entre nuestras deliciosas bebidas naturales y descubre tu combinación perfecta.</p>
    <div class="flex flex-wrap justify-center gap-20 pt-10">
        <div class="flex flex-col items-center">
            <ReactiveLayer bgImage="img/cascara.png" bottleImage="img/layers/cafe-2.png" /><ReactiveText text="Coffté" text_2="Coffé"/>
        </div>
        <div class="flex flex-col items-center">
            <ReactiveLayer bgImage="https://static.vecteezy.com/system/resources/previews/033/303/213/non_2x/ginger-with-ai-generated-free-png.png" bottleImage="img/layers/genjibre.png" /><ReactiveText text="Coffté" text_2="Genjibre"/>
        </div>
        <div class="flex flex-col items-center">
            <ReactiveLayer bgImage="img/panela-limon.png" bottleImage="img/layers/sirope.png" /><ReactiveText text="Coffté" text_2="Sirope"/>
        </div>
    </div>
</section>
