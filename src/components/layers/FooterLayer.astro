---
import '@fontsource/poppins/700.css';
import {Icon} from 'astro-icon/components';

---

<footer class="w-full h-auto bg-[#302216] p-6 md:p-11 md:px-80">
    <div class="flex flex-col md:flex-row justify-between items-center mb-10 md:mb-20">
        <!-- Logo -->
        <a href="#"><img src="/img/logo-white.png" alt="" class="w-12 md:w-20"></a>
        
        <!-- Ubicación -->
        <span class="underline decoration-solid font-[poppins] text-sm md:text-xl text-white flex items-center gap-2 mt-4 md:mt-0">
            <Icon name={"location-dot-solid"} />Colombia
        </span>
    </div>

    <div class="text-sm md:text-xl font-normal text-white flex flex-col md:flex-row justify-between gap-6">
        <!-- Links -->
        <div class="flex flex-col md:flex-row gap-6 md:gap-10 text-center md:text-left">
            <a href="">Contáctanos</a>
            <a href="">Términos y Condiciones</a>
            <a href="">Política de privacidad</a>
        </div>
        
        <!-- Certificados -->
        <div class="flex flex-col md:flex-row gap-4 md:gap-6 justify-center md:justify-end items-center">
            <a href="">
                <img src="img/certificates/negocios-verdes.png" alt="Negocios-verdes" class="w-20 md:w-24 grayscale hover:grayscale-0 transition-all duration-500">
            </a>
            <a href="">
                <img src="img/certificates/sello_positivo.png" alt="Sello Positivo" class="w-36 md:w-56 grayscale hover:grayscale-0 transition-all duration-500">
            </a>
        </div>
    </div>
</footer>
