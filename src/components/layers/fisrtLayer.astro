---
import InteractiveLeaf from '../ReactComponents/InteractiveLeaf';
import '@fontsource/poppins';
---

<div class="flex flex-col md:flex-row p-8 mt-6 md:px-44 bg-[url('/img/bg/bg-1.png')]">
    <div class="flex-1 h-full flex flex-col items-start">
        <h1 class="capitalize poppins-bold md:text-4xl text-3xl text-[#3d1218] mb-4">Del corazón del campo, nacen sabores naturales que transforman</h1>
        <p class="text-lg md:text-xl mt-3 font-bold text-start bg-[#3d1218] text-white px-4 py-2 inline-block uppercase">Recuerda cuidar de ti y de los tuyos.</p>
    </div>    
    <!-- Contenedor de la botella, se oculta en pantallas pequeñas con "hidden" -->
    <div class="flex-1 relative h-full hidden md:block"> 
        <div class="relative mx-auto w-64 md:w-80 h-48 md:h-64">
            <!-- Imagen de la botella con tamaño ajustado y centrada sin afectar el contenedor -->
            <img src="/img/layers/home-product.png" alt="Botella" class="drop-shadow-md absolute flex items-center justify-center inset-0 z-10 botella-tamaño"/>

            <!-- Hojas detrás de la botella, con clases que controlan su visibilidad en pantallas pequeñas -->
            <div class="absolute left-80 top-80 z-30 hidden md:block">
                <InteractiveLeaf height="h-56" width="w-56" client:load pattern="default" imgUrl="https://web.moxcreative.com/happyjuice/wp-content/uploads/sites/16/elementor/thumbs/leave__0001_Layer-3-q2v9blj30m5fteulgt5ojo1ceqejuz5mlnlvuawqgw.png" />
            </div>
            <div class="absolute -left-20 top-56 z-10 hidden md:block">
                <InteractiveLeaf height="h-36" width="w-36" client:load pattern="default2" imgUrl="https://web.moxcreative.com/happyjuice/wp-content/uploads/sites/16/elementor/thumbs/leave__0003_Layer-8-q2v9bnerea80gmrv5tyxonk9li5aadd39wwusuty4g.png" />
            </div>
            <div class="absolute left-64 top-16 rotate-180 hidden md:block">
                <InteractiveLeaf height="h-28" width="w-28" client:load pattern="circular" imgUrl="https://web.moxcreative.com/happyjuice/wp-content/uploads/sites/16/elementor/thumbs/leave__0002_Layer-4-q2v9bmgx7g6q50t8bbkb45st049x2o9cxs9dbkvcao.png" />
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes zoomIn {
        from {
            opacity: 0;
            transform: scale3d(0.3, 0.3, 0.3);
        }
        50% {
            opacity: 1;
        }
    }

    .animate-zoomIn {
        animation: zoomIn 1s ease-out;
    }

    .poppins-bold {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
        font-variation-settings: "wdth" 75, "wght" 400;
    }

    @media (max-width: 1024px) {
        .w-64 {
            width: 200px;
        }
        .h-48 {
            height: 200px;
        }
    }

    /* Ajustes adicionales para pantallas pequeñas (menos de 768px) */
    @media (max-width: 768px) {
        /* Eliminar restricciones max-w y max-h en pantallas pequeñas */
        .botella-tamaño {
            max-width: unset; /* Elimina la restricción de max-width */
            max-height: unset; /* Elimina la restricción de max-height */
            width: 250px; /* Ajusta un tamaño adecuado para la botella */
            height: 250px; /* Ajusta un tamaño adecuado para la botella */
        }

        /* Hacer visible las hojas en pantallas de 768px o más */
        .hidden.md:block {
            display: block !important;
        }

        /* Ajuste de posición de las hojas para que no se salgan del contenedor */
        .absolute {
            position: absolute;
        }

        /* Ajustes para las hojas */
        .absolute.left-80 {
            left: 50%;
            transform: translateX(-50%);
        }
        .absolute.top-80 {
            top: 20%;
        }

        .absolute.left-64 {
            left: 50%;
            transform: translateX(-50%);
        }
        .absolute.top-16 {
            top: 10%;
        }
    }

    @media (min-width: 768px) {
        /* Asegúrate de que las hojas sean visibles solo en pantallas medianas y más grandes */
        .hidden {
            display: block;
        }

        .botella-tamaño{
            width: 350px; 
            height: 350px; 
        }
    }
</style>
