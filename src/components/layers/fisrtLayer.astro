---
import InteractiveLeaf from '../ReactComponents/InteractiveLeaf';
import '@fontsource/poppins';
---
<div class="flex flex-col md:flex-row md:py-28 sm:px-10 md:px-44 px-6 h-[75vh] bg-[url('/img/bg/bg-1.png')] items-center">
    <div class="flex-1 h-full flex flex-col justify-center">
        <h1 class="capitalize poppins-bold md:text-6xl sm:text-6xl text-5xl 2xl:text-7xl text-[#3d1218]">Del corazón del campo, nacen sabores naturales que transforman</h1>
        <p class="sm:text-lg md:text-lg 2xl:text-xl mt-3 font-bold text-start uppercase">
            <span class="bg-[#3d1218] text-white sm:px-5 sm:py-4 px-2 py-1 inline-block">Recuerda cuidar de ti y de los tuyos.</span>
        </p>
    </div>    
    <div class="flex-1 relative h-full hidden lg:block"> 
        <div class="relative mx-auto w-64 md:w-80 h-48 md:h-64">
            <!-- Imagen de la botella con tamaño ajustado y centrada sin afectar el contenedor -->
            <img src="/img/layers/home-product.png" alt="Botella" class="drop-shadow-md absolute top-[-20%] flex items-center justify-center inset-0 max-w-[65vw] max-h-[65vh] z-10 "/> 
            <!-- Hojas detrás de la botella -->
            <div class="absolute lg:left-52 top-80 z-30 hidden lg:block">
                <InteractiveLeaf height="h-56" width="w-56" client:load pattern="default" imgUrl="https://web.moxcreative.com/happyjuice/wp-content/uploads/sites/16/elementor/thumbs/leave__0001_Layer-3-q2v9blj30m5fteulgt5ojo1ceqejuz5mlnlvuawqgw.png" />
            </div>
            <div class="absolute -left-20 top-56 z-10 hidden lg:block">
                <InteractiveLeaf height="h-36" width="w-36"  client:load pattern="default2" imgUrl="https://web.moxcreative.com/happyjuice/wp-content/uploads/sites/16/elementor/thumbs/leave__0003_Layer-8-q2v9bnerea80gmrv5tyxonk9li5aadd39wwusuty4g.png" />
            </div>
            <div class="absolute left-64 top-16 rotate-180 hidden lg:block">
                <InteractiveLeaf height="h-28" width="w-28"  client:load pattern="circular" imgUrl="https://web.moxcreative.com/happyjuice/wp-content/uploads/sites/16/elementor/thumbs/leave__0002_Layer-4-q2v9bmgx7g6q50t8bbkb45st049x2o9cxs9dbkvcao.png" />
            </div>
        </div>
    </div>
</div>


<style>
    @keyframes zoomIn {
        from {
            opacity: 0;
            transform: scale3d(0.3, 0.3, 0.3);
        }
        50% {
            opacity: 1;
        }
    }

    .animate-zoomIn {
        animation: zoomIn 1s ease-out;
    }

    .poppins-bold {
        font-family: 'Poppins', sans-serif;
        font-weight: 800;
    font-variation-settings: "wdth" 75, "wght"
    }
</style>