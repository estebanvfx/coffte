---
import '@fontsource/poppins';
import '@fontsource/poppins/700.css';
---

<section class="w-full h-full bg-[url('https://www.nescafe.com/co/themes/custom/nescafe/assets/sustainability-hub/trees-large.jpg')] bg-cover bg-center bg-no-repeat py-36 relative">
    <div class="absolute inset-0 bg-black opacity-35"></div>
    <div class="text-center text-white text-5xl font-[Poppins] font-extrabold relative z-10 sm:px-32 px-5">
        <h1 class="sm:mb-20 mb-5 text-6xl ">Nuestro Proposito</h1>
        <p class="text-[#fffff4] leading-[1.1] sm:text-xl text-2xl">En Refrescos Naturales Coffté, creamos bebidas refrescantes y deliciosas con ingredientes 100% naturales. Nuestro compromiso es promover tu bienestar y felicidad, inspirando un estilo de vida saludable y sostenible.</p>
        <p class="text-[#F5F5DC] font-[Satisfy] mt-6 text-3xl text-start" >Coffté</p>
    </div>
</section>